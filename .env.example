# Copy values into your process environment or Docker Compose configuration.
# The binary does not automatically load .env files.
MEOW_LISTEN=0.0.0.0:3000
MEOW_DATABASE=data/meowradio.db
# Optional; defaults to a record/ directory beside the database.
# MEOW_RECORDINGS_DIR=data/record
MEOW_REGISTRATION=true
MEOW_SECURE_COOKIE=false
MEOW_RELAY=true
# Set both to create the first administrator without the web wizard.
# Existing installations ignore these values and never reset passwords.
# MEOW_INIT_USERNAME=admin
# MEOW_INIT_PASSWORD=replace-with-a-long-random-password
# HTTP / HTTPS / SOCKS5 (local DNS) outbound proxy; optional credentials.
# MEOW_PROXY=http://127.0.0.1:7890
# Optional self-hosted Radio Browser API base URL, without /json.
# MEOW_CATALOG_URL=https://de1.api.radio-browser.info
